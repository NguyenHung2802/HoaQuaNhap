<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0">Chỉnh sửa bài viết</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/blogs">Tin tức</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>
    </div>
    <div>
        <a href="/admin/blogs" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="fas fa-arrow-left me-1"></i>Hủy và quay lại
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-9">
        <form id="blogForm" action="/admin/blogs/edit/<%= blog.id %>" method="POST" enctype="multipart/form-data" class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Tiêu đề bài viết <span class="text-danger">*</span></label>
                        <input type="text" name="title" id="titleInput" class="form-control form-control-lg rounded-pill border-light-green" value="<%= blog.title %>" required placeholder="Nhập tiêu đề hấp dẫn...">
                    </div>
                    
                    <div class="col-md-12">
                        <label class="form-label fw-bold">Tóm tắt ngắn</label>
                        <textarea name="summary" class="form-control rounded-4 border-light-green" rows="3" placeholder="Đoạn giới thiệu ngắn thu hút độc giả..."><%= blog.summary %></textarea>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label fw-bold">Nội dung chi tiết <span class="text-danger">*</span></label>
                        <div id="editor-container" style="height: 500px;" class="rounded-4 border-light-green"></div>
                        <input type="hidden" name="content" id="contentInput">
                    </div>

                    <div class="col-md-12 mt-4">
                        <div class="form-check form-switch p-3 bg-light rounded-4 border">
                            <input class="form-check-input ms-0 me-3" type="checkbox" name="is_published" id="is_published" <%= blog.is_published ? 'checked' : '' %>>
                            <label class="form-check-label fw-bold" for="is_published">Bài viết đang hiển thị công khai</label>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white p-4 border-top-0 pt-0">
                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold py-3 shadow-sm">
                    <i class="fas fa-save me-2"></i>Cập nhật bài viết
                </button>
            </div>
        </form>
    </div>
    
    <div class="col-lg-3">
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-white py-3">
                <h6 class="mb-0 fw-bold">Ảnh đại diện (Thumbnail)</h6>
            </div>
            <div class="card-body py-3">
                <div class="text-center">
                    <div id="thumb-preview" class="mb-3">
                        <img src="<%= blog.thumbnail_url || 'https://via.placeholder.com/300x180?text=No+Image' %>" alt="Thumbnail" class="w-100 rounded shadow-sm border object-fit-cover" style="height: 150px;">
                    </div>
                    <label class="btn btn-outline-primary btn-sm rounded-pill w-100 mb-2">
                        <i class="fas fa-upload me-2"></i>Thay đổi ảnh
                        <input type="file" name="thumbnail" class="d-none" accept="image/*" onchange="previewThumb(this)" form="blogForm">
                    </label>
                    <small class="text-muted italic">Kích thước khuyên dùng: 800x500px</small>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold">Ảnh phụ <span class="text-muted fw-normal">(tối đa 5 ảnh)</span></h6>
                <span id="gallery-count" class="badge bg-light-green text-primary"></span>
            </div>
            <div class="card-body">
                <% const existingGallery = Array.isArray(blog.gallery) ? blog.gallery : []; %>
                <div id="gallery-existing" class="d-flex flex-wrap gap-2 mb-3">
                    <% existingGallery.forEach(function (url, i) { %>
                        <div class="position-relative gallery-existing-item" data-url="<%= url %>" style="width:70px;">
                            <img src="<%= url %>" class="rounded border w-100" style="height:70px;object-fit:cover;" alt="Ảnh phụ <%= i + 1 %>">
                            <label class="position-absolute top-0 end-0 bg-white rounded-circle border d-flex align-items-center justify-content-center" style="width:20px;height:20px;cursor:pointer;" title="Bỏ ảnh này">
                                <input type="checkbox" name="keep_gallery" value="<%= url %>" checked class="form-check-input m-0" style="width:14px;height:14px;" onchange="this.closest('.gallery-existing-item').style.opacity = this.checked ? 1 : .3; updateGalleryCount();">
                            </label>
                        </div>
                    <% }) %>
                </div>
                <div id="gallery-preview" class="d-flex flex-wrap gap-2 mb-3"></div>
                <label class="btn btn-outline-primary btn-sm rounded-pill w-100 mb-2">
                    <i class="fas fa-images me-2"></i>Thêm ảnh phụ
                    <input type="file" name="gallery" id="galleryInput" class="d-none" accept="image/*" multiple form="blogForm">
                </label>
                <small class="text-muted d-block">Bỏ tick ảnh cũ để xoá. Hiển thị thành dải ảnh ở cuối bài viết.</small>
            </div>
        </div>

        <div class="card bg-light-green border-0 rounded-4 p-4 text-primary">
            <h6 class="fw-bold mb-2">Thông tin bổ sung</h6>
            <div class="small mb-1">ID: #<%= blog.id %></div>
            <div class="small mb-1">Slug: <code class="text-primary-emphasis"><%= blog.slug %></code></div>
            <div class="small mb-1">Tạo: <%= new Date(blog.created_at).toLocaleString('vi-VN') %></div>
            <div class="small">Lần cuối: <%= new Date(blog.updated_at).toLocaleString('vi-VN') %></div>
        </div>
    </div>
</div>

<!-- Quill Editor -->
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
    const quill = new Quill('#editor-container', {
        theme: 'snow',
        modules: {
            toolbar: [
                [{ 'header': [2, 3, 4, false] }],
                ['bold', 'italic', 'underline', 'strike'],
                ['link', 'image', 'video'],
                [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                [{ 'color': [] }, { 'background': [] }],
                ['clean']
            ]
        },
        placeholder: 'Bắt đầu sửa nội dung bài viết...'
    });

    // Set initial content
    quill.root.innerHTML = `<%- blog.content %>`;

    // Preview thumbnail
    function previewThumb(input) {
        const preview = document.getElementById('thumb-preview');
        const previewImg = preview.querySelector('img');
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                previewImg.src = e.target.result;
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Ảnh phụ: đếm số ảnh cũ còn giữ + ảnh mới chọn, không vượt quá 5
    const MAX_GALLERY = 5;
    function keptCount() {
        return document.querySelectorAll('#gallery-existing input[name="keep_gallery"]:checked').length;
    }
    function updateGalleryCount() {
        const kept = keptCount();
        const added = (document.getElementById('galleryInput').files || []).length;
        document.getElementById('gallery-count').textContent = (kept + added) + '/' + MAX_GALLERY;
    }
    document.getElementById('galleryInput').addEventListener('change', function (e) {
        const preview = document.getElementById('gallery-preview');
        const remain = Math.max(0, MAX_GALLERY - keptCount());
        let files = Array.from(e.target.files || []);
        if (files.length > remain) {
            alert('Bạn chỉ còn giữ lại được ' + remain + ' ảnh phụ (tổng tối đa ' + MAX_GALLERY + '). Chỉ ' + remain + ' ảnh đầu được giữ.');
            files = files.slice(0, remain);
            const dt = new DataTransfer();
            files.forEach((f) => dt.items.add(f));
            e.target.files = dt.files;
        }
        preview.innerHTML = '';
        files.forEach((file) => {
            const reader = new FileReader();
            reader.onload = (ev) => {
                const img = document.createElement('img');
                img.src = ev.target.result;
                img.className = 'rounded border';
                img.style.cssText = 'width:70px;height:70px;object-fit:cover;';
                preview.appendChild(img);
            };
            reader.readAsDataURL(file);
        });
        updateGalleryCount();
    });
    updateGalleryCount();

    // Submit form
    document.getElementById('blogForm').onsubmit = function() {
        const content = document.getElementById('contentInput');
        content.value = quill.root.innerHTML;
        return true;
    };
</script>
