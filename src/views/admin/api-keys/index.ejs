<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-0">API Keys</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item active" aria-current="page">API Keys</li>
            </ol>
        </nav>
    </div>
</div>

<% if (newKey) { %>
<div class="alert alert-success border-0 shadow-sm rounded-4">
    <div class="fw-bold mb-1"><i class="fas fa-key me-2"></i>Đã tạo API key “<%= newKeyName %>”</div>
    <p class="small mb-2">Hãy sao chép ngay. Key này <strong>chỉ hiển thị một lần</strong>, rời trang là không xem lại được (chỉ có thể tạo key mới).</p>
    <div class="input-group">
        <input type="text" class="form-control font-monospace" id="newKeyValue" value="<%= newKey %>" readonly>
        <button class="btn btn-success" type="button" id="copyKeyBtn"><i class="fas fa-copy me-1"></i>Sao chép</button>
    </div>
</div>
<% } %>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase">
                            <tr>
                                <th class="ps-4">Tên</th>
                                <th>Key</th>
                                <th>Quyền</th>
                                <th>Lần dùng cuối</th>
                                <th>Trạng thái</th>
                                <th class="text-end pe-4"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (keys && keys.length > 0) { %>
                                <% keys.forEach(k => { %>
                                    <tr>
                                        <td class="ps-4 fw-bold"><%= k.name %></td>
                                        <td><code><%= k.key_prefix %>…</code></td>
                                        <td><span class="badge bg-light text-dark border"><%= k.scopes %></span></td>
                                        <td class="small text-muted"><%= k.last_used_at ? new Date(k.last_used_at).toLocaleString('vi-VN') : 'Chưa dùng' %></td>
                                        <td>
                                            <% if (k.is_active && !k.revoked_at) { %>
                                                <span class="badge bg-success bg-opacity-10 text-success px-3 py-1">Đang hoạt động</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 py-1">Đã thu hồi</span>
                                            <% } %>
                                        </td>
                                        <td class="text-end pe-4">
                                            <% if (k.is_active && !k.revoked_at) { %>
                                                <form method="POST" action="/admin/api-keys/<%= k.id %>/revoke" onsubmit="return confirm('Thu hồi key này? Các tích hợp đang dùng key sẽ ngừng hoạt động.');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Thu hồi</button>
                                                </form>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-key fa-3x mb-3 opacity-10"></i>
                                        <p class="mb-0">Chưa có API key nào. Tạo key đầu tiên ở khung bên phải.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mt-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Cách gọi từ n8n (node HTTP Request)</h6>
                <ul class="small text-muted mb-3">
                    <li>Method: <code>POST</code> — URL: <code>http://localhost:3000/api/v1/posts</code> (n8n chạy cùng VPS) hoặc <code><%= siteUrl %>/api/v1/posts</code>.</li>
                    <li>Header: <code>Authorization: Bearer &lt;API key&gt;</code>.</li>
                    <li>Body JSON hoặc Form-Data (gửi ảnh/video ở các trường <code>cover</code>, <code>images</code>, <code>video</code>).</li>
                    <li><code>status</code> = <code>draft</code> (mặc định, chờ duyệt) hoặc <code>published</code> (đăng ngay). <code>type</code> = <code>blog</code> hoặc <code>news</code> (tin ẩn).</li>
                </ul>
<pre class="bg-light rounded-3 p-3 small mb-0"><code>curl -X POST <%= siteUrl %>/api/v1/posts \
  -H "Authorization: Bearer &lt;API key&gt;" \
  -H "Content-Type: application/json" \
  -d '{
    "title": "Tin dự án đất vùng ven",
    "content": "&lt;p&gt;Nội dung bài viết&lt;/p&gt;",
    "type": "news",
    "status": "draft",
    "external_id": "wf-001",
    "affiliate_url": "https://s.shopee.vn/xxxx"
  }'</code></pre>
                <p class="small text-muted mt-2 mb-0">Tài liệu đầy đủ: <code>docs/12-api-posts.md</code>.</p>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Tạo API key mới</h6>
                <form method="POST" action="/admin/api-keys">
                    <div class="mb-3">
                        <label class="form-label small">Tên gợi nhớ</label>
                        <input type="text" name="name" class="form-control" placeholder="Ví dụ: n8n đăng bài" maxlength="80" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-plus me-2"></i>Tạo key</button>
                </form>
                <hr>
                <p class="small text-muted mb-0">Mỗi tích hợp nên dùng một key riêng để thu hồi riêng khi cần. API giới hạn 60 yêu cầu mỗi phút cho mỗi key. Có thể tắt toàn bộ API bằng cài đặt <code>news.enabled = false</code>.</p>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var btn = document.getElementById('copyKeyBtn');
        if (!btn) return;
        btn.addEventListener('click', function () {
            var input = document.getElementById('newKeyValue');
            input.select();
            (navigator.clipboard ? navigator.clipboard.writeText(input.value) : Promise.resolve(document.execCommand('copy')))
                .then(function () { btn.innerHTML = '<i class="fas fa-check me-1"></i>Đã sao chép'; });
        });
    })();
</script>
