<%
    const n = (v) => Number(v || 0).toLocaleString('vi-VN');
    const pct = (v) => (v === null || v === undefined ? '—' : v.toString().replace('.', ',') + '%');
    const placements = [
        { label: 'Popup', value: totals.cta_popup, color: '#1b4d3e' },
        { label: 'Banner dính', value: totals.cta_banner, color: '#2e7d32' },
        { label: 'Nút cuối bài', value: totals.cta_inline, color: '#f4b400' }
    ];
    const totalClicks = Math.max(1, clicks);
%>
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="mb-0">Thống kê tin ẩn</h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/news">Tin tức ẩn</a></li>
                <li class="breadcrumb-item active" aria-current="page">Thống kê</li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <a href="/admin/news/edit/<%= post.id %>" class="btn btn-outline-primary btn-sm rounded-pill px-3"><i class="fas fa-edit me-1"></i>Sửa bài</a>
        <a href="/admin/news" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Quay lại</a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <div class="fw-bold"><%= post.title %></div>
        <div class="small text-muted">30 ngày gần nhất · giờ Việt Nam · số liệu cập nhật tối đa sau 30 giây · không tính bot và trình xem trước liên kết</div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="small text-muted text-uppercase">Lượt vào</div><div class="fs-2 fw-bold"><%= n(totals.view) %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="small text-muted text-uppercase">Hiện popup</div><div class="fs-2 fw-bold"><%= n(totals.popup_show) %></div><div class="small text-muted">Đóng không bấm: <%= n(totals.popup_close) %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="small text-muted text-uppercase">Lượt bấm link</div><div class="fs-2 fw-bold text-success"><%= n(clicks) %></div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body"><div class="small text-muted text-uppercase">Tỷ lệ bấm</div><div class="fs-2 fw-bold"><%= pct(overallCtr) %></div><div class="small text-muted">trên lượt vào · popup: <%= pct(popupCtr) %></div></div></div></div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Lượt bấm theo vị trí</h6>
                <% placements.forEach(p => { %>
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small"><span><%= p.label %></span><strong><%= n(p.value) %></strong></div>
                        <div class="progress" style="height:8px;"><div class="progress-bar" style="width:<%= Math.round((p.value || 0) / totalClicks * 100) %>%;background:<%= p.color %>"></div></div>
                    </div>
                <% }) %>
                <% if (clicks === 0) { %><div class="small text-muted">Chưa có lượt bấm nào.</div><% } %>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height:460px;">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="bg-light text-muted small text-uppercase" style="position:sticky;top:0;">
                            <tr><th class="ps-4">Ngày</th><th style="min-width:140px;">Lượt vào</th><th class="text-center">Popup</th><th class="text-center">Bấm</th><th class="text-center pe-4">Tỷ lệ</th></tr>
                        </thead>
                        <tbody>
                            <% days.slice().reverse().forEach(d => {
                                const dc = d.cta_popup + d.cta_banner + d.cta_inline; %>
                                <tr class="<%= d.view || dc ? '' : 'text-muted' %>">
                                    <td class="ps-4"><%= d.day.split('-').reverse().join('/') %></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="flex-grow-1 bg-light rounded" style="height:8px;"><div class="rounded" style="height:8px;width:<%= Math.round(d.view / maxDayViews * 100) %>%;background:#2e7d32;"></div></div>
                                            <span class="small" style="min-width:34px;text-align:right;"><%= n(d.view) %></span>
                                        </div>
                                    </td>
                                    <td class="text-center"><%= n(d.popup_show) %></td>
                                    <td class="text-center fw-bold"><%= n(dc) %></td>
                                    <td class="text-center pe-4"><%= d.view > 0 ? pct(Math.round(dc / d.view * 1000) / 10) : '—' %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
