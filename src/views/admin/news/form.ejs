<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet">
<%
    const isEdit = mode === 'edit';
    const v = (k) => (post && post[k] !== undefined && post[k] !== null ? post[k] : '');
    const isPublished = post && (post.is_published === true || post.status === 'published');
    const videoIsFile = /res\.cloudinary\.com\/.+\/video\/upload\//.test(v('video_url'));
%>
<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h4 class="mb-0"><%= isEdit ? 'Chỉnh sửa tin ẩn' : 'Viết tin ẩn mới' %></h4>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/admin">Dashboard</a></li>
                <li class="breadcrumb-item"><a href="/admin/news">Tin tức ẩn</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= isEdit ? 'Sửa' : 'Viết mới' %></li>
            </ol>
        </nav>
    </div>
    <div class="d-flex gap-2">
        <% if (isEdit) { %>
            <a href="/admin/news/stats/<%= post.id %>" class="btn btn-outline-info btn-sm rounded-pill px-3"><i class="fas fa-chart-line me-1"></i>Thống kê</a>
            <a href="/admin/news/preview/<%= post.id %>" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-eye me-1"></i>Xem trước</a>
        <% } %>
        <a href="/admin/news" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i>Quay lại</a>
    </div>
</div>

<% if (error) { %>
    <div class="alert alert-danger border-0 shadow-sm rounded-4"><i class="fas fa-exclamation-circle me-2"></i><%= error %></div>
<% } %>

<% if (isEdit && link) { %>
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body">
            <div class="small text-uppercase text-muted fw-bold mb-2">Link đầy đủ <%= isPublished ? '' : '(chưa đăng: mở sẽ báo 404)' %></div>
            <div class="input-group">
                <input type="text" class="form-control font-monospace small" id="fullLink" value="<%= link %>" readonly>
                <button class="btn btn-outline-primary" type="button" id="copyFullLink"><i class="fas fa-copy me-1"></i>Sao chép</button>
            </div>
            <div class="small text-muted mt-2">Link chứa mã bí mật, không đoán được và không hiện ở bất kỳ đâu trên web.</div>
        </div>
    </div>
<% } %>

<form id="newsForm" action="<%= isEdit ? '/admin/news/edit/' + post.id : '/admin/news' %>" method="POST" enctype="multipart/form-data">
<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold">Tiêu đề <span class="text-danger">*</span></label>
                    <input type="text" name="title" class="form-control form-control-lg" required maxlength="200" value="<%= v('title') %>" placeholder="Tiêu đề thu hút...">
                    <% if (isEdit) { %><div class="form-text">Đường dẫn <code>/tin-tuc/<%= v('url_date') %>/<%= v('slug') %>/…</code> được cố định, đổi tiêu đề không làm hỏng link đã chia sẻ.</div><% } %>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Tóm tắt</label>
                    <textarea name="summary" class="form-control" rows="2" maxlength="500" placeholder="Để trống sẽ tự lấy từ nội dung"><%= v('summary') %></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Nội dung <span class="text-danger">*</span></label>
                    <div id="editor-container" style="height: 420px;"><%- v('content') %></div>
                    <input type="hidden" name="content" id="contentInput">
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mt-4">
            <div class="card-header bg-white py-3"><h6 class="mb-0 fw-bold"><i class="fas fa-bullhorn me-2 text-danger"></i>Popup quảng cáo affiliate</h6></div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-bold">Link affiliate (Shopee / TikTok)</label>
                    <input type="url" name="affiliate_url" class="form-control" value="<%= v('affiliate_url') %>" placeholder="https://s.shopee.vn/...">
                    <div class="form-text">
                        Để trống sẽ dùng link mặc định<%= defaultAffiliate ? ': ' + defaultAffiliate : ' (chưa cài đặt, popup sẽ không hiện)' %>.
                        Chỉ nhận https và host trong danh sách cho phép (<a href="/admin/news/settings">Cài đặt</a>).
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label fw-bold">Tiêu đề trên popup</label>
                        <input type="text" name="ad_headline" class="form-control" maxlength="160" value="<%= v('ad_headline') %>" placeholder="Ví dụ: Giảm đến 50% hôm nay">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold">Chữ nút</label>
                        <input type="text" name="ad_cta_text" class="form-control" maxlength="60" value="<%= v('ad_cta_text') %>" placeholder="Xem ưu đãi">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ảnh popup (tải lên)</label>
                        <input type="file" name="ad_image" class="form-control" accept="image/*">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-bold">hoặc URL ảnh popup</label>
                        <input type="url" name="ad_image_url" class="form-control" placeholder="https://...">
                    </div>
                </div>
                <% if (v('ad_image_url')) { %>
                    <div class="mt-3 small text-muted">Ảnh popup hiện tại:<br><img src="<%= v('ad_image_url') %>" alt="" class="rounded border mt-1" style="max-height:90px;"></div>
                <% } %>
                <div class="small text-muted mt-3">Bấm vào thân popup mở link ở tab mới. Nút X và vùng nền chỉ đóng popup. Popup luôn ghi rõ "Quảng cáo · Liên kết tiếp thị".</div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-white py-3"><h6 class="mb-0 fw-bold">Đăng bài</h6></div>
            <div class="card-body">
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="status" id="stDraft" value="draft" <%= isPublished ? '' : 'checked' %>>
                    <label class="form-check-label" for="stDraft">Bản nháp (link trả 404)</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="status" id="stPub" value="published" <%= isPublished ? 'checked' : '' %>>
                    <label class="form-check-label" for="stPub">Đăng (ai có link đều đọc được)</label>
                </div>
                <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2"><i class="fas fa-save me-2"></i><%= isEdit ? 'Lưu thay đổi' : 'Lưu' %></button>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-white py-3"><h6 class="mb-0 fw-bold">Ảnh bìa</h6></div>
            <div class="card-body">
                <% if (v('thumbnail_url')) { %><img src="<%= v('thumbnail_url') %>" alt="" class="w-100 rounded border mb-2" style="max-height:160px;object-fit:cover;"><% } %>
                <input type="file" name="cover" class="form-control" accept="image/*">
                <div class="form-text">Tối đa 5MB. Gợi ý 1200x630 để chia sẻ đẹp trên mạng xã hội.</div>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4 mb-4">
            <div class="card-header bg-white py-3"><h6 class="mb-0 fw-bold">Video</h6></div>
            <div class="card-body">
                <% if (videoIsFile) { %>
                    <div class="small text-muted">Video đã tải lên (từ API) được giữ nguyên.</div>
                <% } else { %>
                    <input type="url" name="video_embed_url" class="form-control" value="<%= v('video_url') %>" placeholder="Link YouTube / TikTok / Facebook">
                    <div class="form-text">Xóa trống để gỡ video. Video dùng link nhúng để tiết kiệm dung lượng.</div>
                <% } %>
            </div>
        </div>

        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-header bg-white py-3"><h6 class="mb-0 fw-bold">Thẻ và SEO</h6></div>
            <div class="card-body">
                <label class="form-label small fw-bold">Thẻ (cách nhau dấu phẩy)</label>
                <input type="text" name="tags" class="form-control mb-3" value="<%= v('tags') %>">
                <label class="form-label small fw-bold">Tiêu đề khi chia sẻ</label>
                <input type="text" name="seo_title" class="form-control mb-3" maxlength="160" value="<%= v('seo_title') %>">
                <label class="form-label small fw-bold">Mô tả khi chia sẻ</label>
                <textarea name="seo_description" class="form-control" rows="3" maxlength="320"><%= v('seo_description') %></textarea>
            </div>
        </div>
    </div>
</div>
</form>

<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>
<script>
    var quill = new Quill('#editor-container', {
        theme: 'snow',
        modules: { toolbar: [[{ header: [2, 3, 4, false] }], ['bold', 'italic', 'underline', 'strike'], ['link', 'image'], [{ list: 'ordered' }, { list: 'bullet' }], ['blockquote'], ['clean']] },
        placeholder: 'Viết nội dung tại đây...'
    });
    document.getElementById('newsForm').addEventListener('submit', function (e) {
        document.getElementById('contentInput').value = quill.root.innerHTML;
        if (quill.getText().trim().length === 0 && !quill.root.innerHTML.includes('<img')) {
            e.preventDefault();
            alert('Vui lòng nhập nội dung bài viết!');
        }
    });
    var copyBtn = document.getElementById('copyFullLink');
    if (copyBtn) copyBtn.addEventListener('click', function () {
        var input = document.getElementById('fullLink');
        input.select();
        (navigator.clipboard ? navigator.clipboard.writeText(input.value) : Promise.resolve(document.execCommand('copy')))
            .then(function () { copyBtn.innerHTML = '<i class="fas fa-check me-1"></i>Đã sao chép'; });
    });
</script>
