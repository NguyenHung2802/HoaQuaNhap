<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Trang chủ' %> | Hải Anh Fruit — Trái Cây Nhập Khẩu</title>
    <meta name="description" content="<%= typeof metaDesc !== 'undefined' ? metaDesc : 'Cửa hàng trái cây nhập khẩu cao cấp — Tươi ngon, chất lượng đảm bảo, giao hàng tận nhà.' %>">
    <% if (typeof title !== 'undefined' && title === 'Trang chủ') { %>
    <meta name="google-site-verification" content="ygLsmpi34UD9zW65OH6qIFbWxk1qE6mbv0mqc6xdEgE" />
    <% } %>
    <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %><link rel="canonical" href="<%= canonicalUrl %>"><% } %>
    <%- typeof headExtra !== 'undefined' ? headExtra : '' %>
    <!-- Favicon -->
    <link rel="icon" href="/images/favicon.png" type="image/png">
    <% const isV2 = (typeof uiTheme !== 'undefined' && uiTheme === 'v2'); %>
    <% if (isV2) { %>
    <!-- v2: thư viện + phông chữ phục vụ từ chính server (không chờ 5 tên miền CDN: mỗi tên miền tốn 0,5-1,3 giây DNS+TLS) -->
    <link rel="preload" href="/vendor/fonts/QGYvz_MVcBeNP4NJtEtq.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/vendor/fonts/nuFiD-vYSZviVYUb_rj3ij__anPXDTPYgFE_.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/vendor/fonts/nuFiD-vYSZviVYUb_rj3ij__anPXDTzYgA.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/vendor/fonts/fonts.css">
    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/vendor/swiper/swiper-bundle.min.css">
    <% } else { %>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css">
    <!-- AOS CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <% } %>
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <% if (isV2) { %>
    <!-- Giao diện v2 (S51): lớp phủ CSS/JS, tắt bằng UI_THEME=classic -->
    <link rel="stylesheet" href="/css/theme-v2.css?v=s51">
    <% } %>
</head>
<body class="<%= isV2 ? 'theme-v2' : '' %>">
    <% if (isV2) { %><div id="tv2-progress" aria-hidden="true"></div><% } %>
    <%- include('../partials/navbar') %>

    <main>
        <%- include('../partials/flash') %>
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <%- include('../partials/mobile-bottom-nav') %>

    <% if (isV2) { %>
        <%- include('../partials/mini-cart') %>
    <% } %>

    <script>
        const AUTH_STATE = { isLoggedIn: <%= !!user %> };
    </script>
    <% if (isV2) { %>
    <script src="/vendor/bootstrap/bootstrap.bundle.min.js"></script>
    <script src="/vendor/swiper/swiper-bundle.min.js"></script>
    <script src="/vendor/sweetalert2/sweetalert2.all.min.js"></script>
    <% } else { %>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Swiper JS -->
    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- AOS JS -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <% } %>
    <!-- Custom JS -->
    <script src="/js/main.js"></script>
    <script src="/js/cart.js"></script>
    <% if (!isV2) { %>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof AOS !== 'undefined') {
                AOS.init({ once: true, offset: 50, duration: 800 });
            }
        });
    </script>
    <% } %>

    <% if (isV2) { %>
    <script src="/js/theme-v2.js?v=s51" defer></script>
    <% } %>

    <!-- Floating Contact Popup -->
    <%- include('../partials/contact-popup') %>
</body>
</html>
