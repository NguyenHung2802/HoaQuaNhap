<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= pageTitle %></title>
    <meta name="description" content="<%= pageDesc %>">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta property="og:type" content="article">
    <meta property="og:title" content="<%= pageTitle %>">
    <meta property="og:description" content="<%= pageDesc %>">
    <meta property="og:url" content="<%= canonicalUrl %>">
    <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>"><meta name="twitter:card" content="summary_large_image"><% } %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@500;700&display=swap" rel="stylesheet">
    <style>
        :root{--ink:#14201a;--mut:#6b7480;--line:#ececE6;--g1:#1b4d3e;--g2:#2e7d32;--y:#f4b400;--ser:'Playfair Display',Georgia,serif;--sans:'Outfit','Segoe UI',system-ui,sans-serif;--ease:cubic-bezier(.2,.8,.2,1)}
        *{box-sizing:border-box;margin:0}
        body{font-family:var(--sans);color:var(--ink);background:#fff;line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden}
        .bar{border-bottom:1px solid var(--line);padding:14px 20px;text-align:center;font-size:12.5px;letter-spacing:2.4px;text-transform:uppercase;color:var(--g2);font-weight:600}
        main{max-width:760px;margin:0 auto;padding:36px 20px 80px}
        .meta{color:var(--mut);font-size:14px;display:flex;gap:10px;flex-wrap:wrap;align-items:center}
        .meta i{width:4px;height:4px;border-radius:50%;background:#c7ccd1;display:inline-block}
        h1{font-family:var(--ser);font-size:clamp(32px,6vw,52px);line-height:1.1;letter-spacing:-1px;color:var(--g1);margin:14px 0 16px}
        .lead{font-size:19px;color:#3d4a43;margin-bottom:26px}
        .cover{width:100%;border-radius:22px;margin:6px 0 28px;aspect-ratio:16/9;object-fit:cover;background:#f3f5f1;display:block}
        .video{position:relative;aspect-ratio:16/9;border-radius:20px;overflow:hidden;margin:6px 0 28px;background:#000}
        .video iframe,.video video{position:absolute;inset:0;width:100%;height:100%;border:0}
        .body{font-size:18px}
        .body p{margin:0 0 1.15em}
        .body h2,.body h3,.body h4{font-family:var(--ser);color:var(--g1);line-height:1.2;margin:1.6em 0 .6em}
        .body img{max-width:100%;height:auto;border-radius:16px;margin:.6em 0}
        .body a{color:var(--g2);text-decoration:underline;text-underline-offset:3px}
        .body blockquote{border-left:4px solid var(--y);padding:4px 0 4px 18px;color:#3d4a43;font-family:var(--ser);font-size:1.1em;margin:1.4em 0}
        .body ul,.body ol{padding-left:1.3em;margin:0 0 1.15em}
        .body table{border-collapse:collapse;width:100%;margin:1em 0;display:block;overflow-x:auto}
        .body th,.body td{border:1px solid var(--line);padding:8px 12px}
        .body iframe{max-width:100%;border:0;border-radius:14px}
        .gal{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px;margin:28px 0}
        .gal img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:14px}
        .tags{display:flex;gap:8px;flex-wrap:wrap;margin:28px 0 0}
        .tags span{border:1px solid var(--line);border-radius:99px;padding:4px 14px;font-size:13.5px;color:var(--mut)}
        .cta-box{margin:40px 0 0;border:1px solid var(--line);border-radius:24px;padding:26px;background:linear-gradient(135deg,#f4faf5,#fff);text-align:center}
        .cta-box small{display:block;color:var(--mut);font-size:12.5px;letter-spacing:1.2px;text-transform:uppercase;margin-bottom:8px}
        .cta{display:inline-flex;gap:8px;align-items:center;background:var(--g1);color:#fff;border-radius:99px;padding:15px 30px;font-weight:600;font-size:17px;text-decoration:none;transition:background .3s,transform .3s var(--ease),box-shadow .3s}
        .cta:hover{background:var(--g2);transform:translateY(-2px);box-shadow:0 14px 30px rgba(27,77,62,.25)}
        footer{border-top:1px solid var(--line);padding:22px 20px;text-align:center;font-size:13px;color:var(--mut)}
        /* Popup affiliate + banner dính (JS: /assets/news.js) */
        .np-overlay{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:16px;background:rgba(14,28,20,.58);backdrop-filter:blur(5px);opacity:0;transition:opacity .25s ease}
        .np-overlay.on{opacity:1}
        .np-wrap{position:relative;width:min(720px,100%);max-height:calc(100vh - 32px);transform:translateY(18px) scale(.96);transition:transform .35s var(--ease)}
        .np-overlay.on .np-wrap{transform:none}
        .np-card{display:block;background:#fff;border-radius:28px;overflow:hidden;box-shadow:0 40px 100px rgba(0,0,0,.35);text-decoration:none;color:inherit;cursor:pointer;outline-offset:4px;max-height:calc(100vh - 32px)}
        .np-media{display:block;position:relative;aspect-ratio:16/10;max-height:min(52vh,440px);width:100%;background:#eef3ee;overflow:hidden}
        .np-media img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .8s var(--ease)}
        .np-card:hover .np-media img{transform:scale(1.05)}
        .np-body{display:block;padding:22px 26px 28px;text-align:center}
        .np-tag{display:inline-block;font-size:11.5px;letter-spacing:1.4px;text-transform:uppercase;color:var(--mut);margin-bottom:10px}
        .np-title{display:block;font-family:var(--ser);font-size:clamp(24px,4.4vw,34px);line-height:1.15;color:var(--g1);margin-bottom:18px}
        .np-cta{display:inline-block;background:var(--g1);color:#fff;border-radius:99px;padding:16px 38px;font-weight:700;font-size:18px;animation:npPulse 2.2s ease-in-out infinite;transition:background .3s}
        .np-card:hover .np-cta{background:var(--g2)}
        @keyframes npPulse{0%,100%{box-shadow:0 0 0 0 rgba(27,77,62,.35)}50%{box-shadow:0 0 0 12px rgba(27,77,62,0)}}
        .np-x{position:absolute;top:10px;right:10px;width:36px;height:36px;border-radius:50%;border:0;background:rgba(255,255,255,.9);color:#6b7480;font-size:22px;line-height:1;cursor:pointer;box-shadow:0 2px 10px rgba(0,0,0,.18);transition:background .2s,color .2s,transform .2s}
        .np-x:hover{background:#fff;color:var(--ink);transform:rotate(90deg)}
        @media(max-width:560px){.np-wrap{width:100%}.np-media{aspect-ratio:4/3;max-height:42vh}.np-body{padding:18px 18px 22px}.np-cta{padding:15px 28px;font-size:17px}}
        .nb{position:fixed;left:12px;right:12px;bottom:12px;max-width:760px;margin:0 auto;z-index:900;background:#fff;border:1px solid var(--line);border-radius:20px;box-shadow:0 14px 44px rgba(20,32,26,.22);display:flex;align-items:center;transform:translateY(130%);transition:transform .45s var(--ease)}
        .nb.on{transform:none}
        .nb-link{display:flex;align-items:center;gap:12px;flex:1;min-width:0;padding:10px 6px 10px 10px;text-decoration:none;color:inherit}
        .nb-img{width:52px;height:52px;border-radius:12px;object-fit:cover;flex:none}
        .nb-text{display:block;min-width:0;flex:1;line-height:1.3}
        .nb-text small{display:block;font-size:10.5px;letter-spacing:1px;text-transform:uppercase;color:var(--mut)}
        .nb-text b{display:block;font-size:15px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
        .nb-btn{flex:none;background:var(--g1);color:#fff;border-radius:99px;padding:10px 18px;font-weight:600;font-size:14px;white-space:nowrap}
        .nb-x{flex:none;width:36px;height:36px;margin-right:8px;border:0;background:transparent;color:#9aa1a8;font-size:22px;cursor:pointer;border-radius:50%}
        .nb-x:hover{background:#f1f3f0;color:var(--ink)}
        body.has-banner{padding-bottom:92px}
        @media(max-width:420px){.nb-btn{padding:9px 14px;font-size:13px}.nb-img{width:44px;height:44px}}
        @media(prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
    </style>
</head>
<body data-post-id="<%= post.id %>" data-token="<%= post.access_token %>">
    <div class="bar">Bản tin</div>
    <main>
        <article>
            <div class="meta"><span><%= dateLabel %></span><i></i><span><%= readMinutes %> phút đọc</span></div>
            <h1><%= post.title %></h1>
            <% if (post.summary) { %><p class="lead"><%= post.summary %></p><% } %>

            <% if (coverUrl) { %><img class="cover" src="<%= coverUrl %>" alt="<%= post.title %>" fetchpriority="high"><% } %>

            <% if (videoUrl) { %>
                <div class="video">
                    <% if (isFileVideo) { %>
                        <video src="<%= videoUrl %>" controls preload="metadata" playsinline></video>
                    <% } else { %>
                        <iframe src="<%= videoUrl %>" title="Video" loading="lazy" allowfullscreen allow="accelerometer; encrypted-media; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
                    <% } %>
                </div>
            <% } %>

            <%# Nội dung đã được làm sạch ở posts.service (sanitizeContent) khi lưu bài %>
            <div class="body"><%- post.content %></div>

            <% if (gallery.length) { %>
                <div class="gal"><% gallery.forEach(function (u) { %><img src="<%= u %>" alt="" loading="lazy"><% }) %></div>
            <% } %>

            <% if (tags.length) { %><div class="tags"><% tags.forEach(function (t) { %><span>#<%= t %></span><% }) %></div><% } %>

            <% if (affiliateUrl) { %>
                <div class="cta-box" id="cta-inline">
                    <small>Quảng cáo · Liên kết tiếp thị</small>
                    <% if (post.ad_headline) { %><p style="font-family:var(--ser);font-size:24px;color:var(--g1);margin:0 0 14px;line-height:1.25"><%= post.ad_headline %></p><% } %>
                    <a class="cta" data-cta="inline" href="<%= affiliateUrl %>" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= ctaText %> <span aria-hidden="true">→</span></a>
                </div>
            <% } %>
        </article>
    </main>
    <% if (popupJson) { %>
    <script type="application/json" id="news-config"><%- popupJson %></script>
    <script src="/assets/news.js" defer></script>
    <% } %>
    <footer>Bài viết có chứa liên kết tiếp thị. Chúng tôi có thể nhận hoa hồng khi bạn mua hàng qua liên kết, không làm tăng giá bạn phải trả.</footer>
</body>
</html>
